<%- include('partials/header', {title:'Result', active}) %>
<h1 class="page-title">Eligibility Result</h1>
<p class="page-sub">Application #<%= r.id %> for <%= r.name %></p>
<div class="card-box">
  <div class="p-5 text-center">
    <i class="bi <%= r.approved?'bi-check-circle-fill text-success':'bi-x-circle-fill text-danger' %>" style="font-size:4.5rem"></i>
    <h2 class="mt-3"><%= r.approved ? 'Loan Approved' : 'Loan Rejected' %></h2>
    <p class="text-muted">Approval probability: <b><%= Math.round(r.probability*100) %>%</b></p>
    <div class="progress mx-auto mb-3" style="max-width:420px;height:14px">
      <div class="progress-bar <%= r.approved?'bg-success':'bg-danger' %>" style="width:<%= Math.round(r.probability*100) %>%"></div></div>
    <% if (r.source === 'demo') { %><div class="alert alert-warning d-inline-block py-2 small">Demo scoring used (ML service not reachable at ML_URL).</div><br><% } %>
    <a href="/apply" class="btn btn-primary mt-2">New Application</a>
    <a href="/application" class="btn btn-outline-secondary mt-2">View All</a>
  </div>
</div>
<div class="card-box">
  <div class="card-head">Features sent to model</div>
  <div class="p-3 table-responsive"><table class="table table-sm mb-0">
    <% Object.entries(r.features).forEach(([k,v]) => { %><tr><td><%= k %></td><td><%= v %></td></tr><% }) %>
  </table></div>
</div>
<%- include('partials/footer') %>
