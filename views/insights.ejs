<%- include('partials/header', {title:'Model Insights', active}) %>
<h1 class="page-title">Model Insights</h1>
<p class="page-sub">Feature importance (sample values - replace with your model's real numbers in server.js).</p>
<div class="card-box"><div class="card-head">Feature Importance</div>
<div class="p-4">
<% importance.forEach(([n,v]) => { %>
  <div class="mb-3"><div class="d-flex justify-content-between small"><span><%= n %></span><span><%= v %>%</span></div>
  <div class="progress" style="height:12px"><div class="progress-bar" style="width:<%= v %>%"></div></div></div>
<% }) %>
</div></div>
<%- include('partials/footer') %>
