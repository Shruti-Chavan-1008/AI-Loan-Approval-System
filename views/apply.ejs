<%- include('partials/header', {title:'Apply for Loan', active}) %>
<h1 class="page-title">Apply for Loan</h1>
<p class="page-sub">Enter your details to check loan eligibility.</p>
<% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

<form method="POST" action="/apply" id="loanForm" novalidate>

  <div class="card-box">
    <div class="card-head">Personal Information</div>
    <div class="p-4 row g-4">
      <div class="col-md-4"><label class="form-label">Full Name</label>
        <input name="full_name" class="form-control" required></div>
      <div class="col-md-4"><label class="form-label">Age</label>
        <input name="age" type="number" min="18" max="75" class="form-control" required></div>
      <div class="col-md-4"><label class="form-label">Gender</label>
        <select name="gender" class="form-select" required>
          <option value="">Select</option><option>Male</option><option>Female</option></select></div>
      <div class="col-md-4"><label class="form-label">Dependents</label>
        <input name="dependents" type="number" min="0" max="10" class="form-control" required></div>
    </div>
  </div>

  <div class="card-box">
    <div class="card-head">Financial Information</div>
    <div class="p-4 row g-4">
      <div class="col-md-4"><label class="form-label">Applicant Income (₹)</label>
        <input name="applicant_income" id="income" type="number" min="0" step="any" class="form-control" required></div>
      <div class="col-md-4"><label class="form-label">Co-applicant Income (₹)</label>
        <input name="coapplicant_income" id="coincome" type="number" min="0" step="any" class="form-control" value="0"></div>
      <div class="col-md-4"><label class="form-label">Loan Amount (₹)</label>
        <input name="loan_amount" id="loanAmt" type="number" min="1" step="any" class="form-control" required></div>
      <div class="col-md-4"><label class="form-label">Savings (₹)</label>
        <input name="savings" type="number" min="0" step="any" class="form-control" value="0"></div>
      <div class="col-md-4"><label class="form-label">Collateral Value (₹)</label>
        <input name="collateral_value" type="number" min="0" step="any" class="form-control" value="0"></div>
      <div class="col-md-4"><label class="form-label">DTI Ratio <small class="text-muted">(0 – 1, e.g. 0.25)</small></label>
        <input name="dti_ratio" id="dti" type="number" min="0" max="1" step="0.01" class="form-control" required></div>
    </div>
  </div>

  <div class="card-box">
    <div class="card-head">Credit &amp; Loan Details</div>
    <div class="p-4 row g-4">
      <div class="col-md-4"><label class="form-label">Credit Score <small class="text-muted">(300 – 900)</small></label>
        <input name="credit_score" type="number" min="300" max="900" class="form-control" required></div>
      <div class="col-md-4"><label class="form-label">Existing Loans</label>
        <input name="existing_loans" type="number" min="0" max="20" class="form-control" value="0"></div>
      <div class="col-md-4"><label class="form-label">Loan Purpose</label>
        <select name="loan_purpose" class="form-select" required>
          <option value="">Select</option><option>Education</option><option>Home</option>
          <option>Personal</option><option>Business</option></select></div>
    </div>
  </div>

  <div class="card-box">
    <div class="card-head">Employment &amp; Property</div>
    <div class="p-4 row g-4">
      <div class="col-md-4"><label class="form-label">Employer Category</label>
        <select name="employer_category" class="form-select" required>
          <option value="">Select</option><option>Government</option><option>MNC</option>
          <option>Private</option><option>Unemployed</option><option value="Other">Self-Employed / Other</option></select></div>
      <div class="col-md-4"><label class="form-label">Property Area</label>
        <select name="property_area" class="form-select" required>
          <option value="">Select</option><option>Urban</option><option>Semiurban</option><option>Rural</option></select></div>
      <div class="col-md-4 d-flex align-items-end">
        <div class="hint w-100" id="hint"><i class="bi bi-info-circle"></i> Fill income &amp; loan amount to see a quick ratio.</div></div>
    </div>
  </div>

  <div class="d-flex gap-2 mb-5">
    <button class="btn btn-primary btn-lg px-5"><i class="bi bi-cpu"></i> Check Eligibility</button>
    <button type="reset" class="btn btn-outline-secondary btn-lg">Reset</button>
  </div>
</form>
<%- include('partials/footer') %>
